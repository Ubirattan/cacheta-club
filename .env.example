# Copie para .env.local (no computador) e cadastre as mesmas no Netlify (Site settings > Environment variables)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-aqui-a-anon-public-key
# SECRETA: nunca coloque no código nem no navegador
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key

# Mercado Pago (Pix): Seu negócio > Credenciais > "Access Token" de PRODUÇÃO (APP_USR-...). SECRETA.
MP_ACCESS_TOKEN=
# Endereço do site, sem barra no final (ex.: https://cacheta-club.netlify.app)
SITE_URL=
